# Copy to .env at repo root, then fill in your DeepSeek API key.
# .env is gitignored.

DEEPSEEK_API_KEY=sk-replace-me
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # default; override only if you proxy

# Optional model overrides (defaults shown).
# DEEPSEEK_ROUTER_MODEL=deepseek-v4-flash
# DEEPSEEK_KNOWLEDGE_MODEL=deepseek-v4-flash
# DEEPSEEK_PLAN_MODEL=deepseek-v4-pro
# DEEPSEEK_PRODUCT_SUPPORT_MODEL=deepseek-v4-flash
# DEEPSEEK_ANSWER_MODEL=deepseek-v4-flash
# DEEPSEEK_QUERY_SUPPORT_SUMMARY_MODEL=deepseek-v4-flash

# Optional: device for sentence-transformers bge-m3 (cpu / cuda / mps).
# AGENT_V3_EMBED_DEVICE=cpu
